<div id="rel">Memuat...</div>

<script>
// Masukkan semua URL feed website lain di dalam array ini
const x = [
  "https://blogeespss.blogspot.com/feeds/posts/default",
  "https://www.cnbcindonesia.com/tech/rss"
];

// Fungsi untuk mengambil data dari API rss2json
const g = u => fetch("https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(u)).then(r => r.json());

(async () => {
  try {
    // Mengambil data dari semua feed secara bersamaan
    let e = await Promise.all(x.map(g));
    
    let a = [];
    // Mengambil masing-masing maksimal 3 artikel dari setiap website
    e.map(r => a.push(...(r?.items?.slice(0, 3) || [])));
    
    // Mengacak urutan artikel dan menampilkannya ke HTML
    document.getElementById('rel').innerHTML = "<h3>Artikel Terkait</h3><ul>" + 
      a.sort(() => Math.random() - .5)
       .map(i => `<li><a href="${i.link}" target="_blank" rel="noopener">${i.title}</a></li>`)
       .join("") + 
      "</ul>";
  } catch (error) {
    console.error("Gagal memuat feed:", error);
    // Menghilangkan tulisan "Memuat..." jika terjadi error
    document.getElementById('rel').innerHTML = ""; 
  }
})();
</script>
